{
  "package": {
    "productName": "Phantom Tunnel",
    "version": "5.0.0"
  },
  "build": {
    "distDir": "../gui/dist",
    "devPath": "http://localhost:3000",
    "beforeBuildCommand": "npm run build"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.phantom.tunnel",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "updater": {
      "active": true,
      "pubkey": "-----BEGIN PUBLIC KEY-----\nMIGbMBAGByqGSM49AgEGBSuBBAAjA4GGAAQ...\n-----END PUBLIC KEY-----"
    },
    "allowlist": {
      "shell": {
        "open": true
      },
      "fs": {
        "scope": ["$APPCONFIG/*", "$APPCACHE/*"]
      }
    }
  }
}